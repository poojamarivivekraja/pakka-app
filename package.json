{
  "name": "pakka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:profiles": "tsx scripts/check-profiles.ts",
    "check": "npm run -s check:profiles && npm run -s check:orders-view && npm run -s check:order-detail && npm run -s check:source-sheet && npm run -s check:pipeline && npm run -s check:pipeline-db && npm run -s check:order-actions && npm run -s check:llm",
    "check:llm": "tsx --conditions=react-server scripts/check-llm.ts",
    "check:pipeline": "tsx --conditions=react-server scripts/check-pipeline.ts",
    "check:pipeline-db": "tsx --conditions=react-server scripts/check-pipeline-db.ts",
    "scenario": "tsx --conditions=react-server scripts/run-scenario.ts",
    "check:passcode": "tsx --conditions=react-server scripts/check-passcode.ts",
    "check:orders-view": "tsx --conditions=react-server scripts/check-orders-view.ts",
    "check:order-actions": "tsx --conditions=react-server scripts/check-order-actions.ts",
    "check:order-detail": "tsx --conditions=react-server scripts/check-order-detail.ts",
    "check:source-sheet": "tsx scripts/check-source-sheet.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
